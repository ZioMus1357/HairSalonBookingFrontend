{
  "name": "hair-salon-booking-mobile",
  "version": "2.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --port 8082",
    "web": "expo start --web --port 8082",
    "web:8083": "expo start --web --port 8083",
    "android": "expo start --android --port 8082",
    "ios": "expo start --ios --port 8082",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web --output-dir dist && node scripts/prepare-pages.js",
    "export:web": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@microsoft/signalr": "^8.0.7",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "^54.0.34",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
